{
  "name": "fw-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "start:standalone": "DATABASE_URL=${DATABASE_URL} PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "prod": "npm run build && npm run postbuild && npm run start:standalone",
    "postbuild": "cp -r public .next/standalone/public 2>/dev/null; mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static 2>/dev/null; cp .env.local .next/standalone/.env.local 2>/dev/null; echo 'Standalone ready'",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed": "npx tsx scripts/seed.ts",
    "seed:psa": "npx tsx scripts/seed-psa-stammdaten.ts",
    "setup": "npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "next": "^16.3.7",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.7",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
