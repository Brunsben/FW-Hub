# FW-Hub - Umgebungsvariablen fuer Docker Compose (Datei .env neben docker-compose.yml)
# Kopie: cp .env.example .env, danach Werte eintragen. Niemals committen.
# Passwoerter bevorzugt als Hex (openssl rand -hex 24): keine Sonderzeichen, nichts zu kodieren.

# PostgreSQL (Owner-Rolle, nur fuer den Datenbank-Container und Migrationen)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Anwendungsrollen (muessen den Passwoertern der Datenbankrollen entsprechen)
FW_APP_PASSWORD=
FW_AUTH_PASSWORD=

# Sitzungen, mindestens 32 Zeichen
JWT_SECRET=

# Host-Ports
PORTAL_PORT=8180
UPTIME_PORT=3001

# Lokale Entwicklung (.env.local, nicht fuer Docker Compose):
# DATABASE_URL=postgresql://fw_app:<Passwort>@localhost:5432/fwhub_dev
# AUTH_DATABASE_URL=postgresql://fw_auth:<Passwort>@localhost:5432/fwhub_dev
# MIGRATE_DATABASE_URL=postgresql://postgres:<Passwort>@localhost:5432/fwhub_dev   (nie in den Portal-Container)
# JWT_SECRET=

# Fuehrerscheinkontrolle (noch nicht migriert), kommt mit der FK-App zurueck:
# FW_ENCRYPTION_KEY, FW_BACKUP_API_KEY, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM
# E-Mail-Versand (SMTP_*) ist derzeit ungenutzt; nodemailer ist bewusst nicht
# installiert. Release 2 (Dienstplan-Erinnerungen, FK-App): nodemailer >= 10.1.4
# neu einbinden und die SMTP_*-Variablen dann hier dokumentieren.